// HORNAFRIKA — regional news & information platform
// SQLite for local development. Switching to Postgres is a datasource change:
// no model in this file depends on a SQLite-specific feature.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Postgres in production. For offline local work, change this one line to
  // "sqlite", point DATABASE_URL at file:./dev.db and run `npm run db:reset`.
  // No model in this file uses a provider-specific feature, so the switch is
  // genuinely just this line.
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Geography
// ---------------------------------------------------------------------------

model Country {
  id         String  @id @default(cuid())
  slug       String  @unique
  name       String
  nativeName String?
  flag       String // emoji flag, used in nav and country blocks
  blurb      String // one-paragraph description on the country page
  capital    String
  accent     String // hex, used sparingly for the country rule
  order      Int     @default(0)

  regions          Region[]
  articles         Article[]        @relation("PrimaryCountry")
  articleCountries ArticleCountry[]
  videos           Video[]
  sources          Source[]
  wireItems        WireItemCountry[]

  @@index([order])
}

// Regions are additive: a new Ethiopian region is a row, not a migration.
model Region {
  id        String  @id @default(cuid())
  slug      String
  name      String
  blurb     String?
  countryId String
  order     Int     @default(0)

  country  Country   @relation(fields: [countryId], references: [id], onDelete: Cascade)
  articles Article[]

  @@unique([countryId, slug])
  @@index([countryId, order])
}

// ---------------------------------------------------------------------------
// Taxonomy
// ---------------------------------------------------------------------------

// kind distinguishes an editorial desk (Politics) from a format (Explained,
// People, Video) so navigation and layout can treat them differently.
enum CategoryKind {
  DESK
  FORMAT
  REGIONAL
}

model Category {
  id       String       @id @default(cuid())
  slug     String       @unique
  name     String
  kind     CategoryKind @default(DESK)
  color    String // chip colour token name
  blurb    String?
  inNav    Boolean      @default(true)
  order    Int          @default(0)

  subcategories Subcategory[]
  articles      Article[]

  @@index([order])
}

model Subcategory {
  id         String @id @default(cuid())
  slug       String
  name       String
  categoryId String
  order      Int    @default(0)

  category Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  articles Article[]

  @@unique([categoryId, slug])
}

model Topic {
  id   String @id @default(cuid())
  slug String @unique
  name String

  articles ArticleTopic[]
}

// ---------------------------------------------------------------------------
// People
// ---------------------------------------------------------------------------

model Author {
  id         String  @id @default(cuid())
  slug       String  @unique
  name       String
  title      String
  bio        String
  avatarSeed String
  location   String?

  /**
   * A desk is an institutional byline — "Hornafrika Desk" — not a person.
   * It exists so that copy without a named reporter is still attributable
   * without inventing one. Article schema emits Organization for a desk and
   * Person only for a real journalist, so we never publish structured data
   * claiming a byline belongs to someone who does not exist.
   */
  isDesk Boolean @default(false)

  articles Article[]
  user     User?
}

/**
 * Where a self-registered reporter is in the verification process.
 *
 * Accounts created by an administrator are VERIFIED outright; only people who
 * applied through /contribute start as PENDING. A PENDING account exists but
 * cannot sign in, so an unverified applicant has no access to anything.
 */
enum ContributorStatus {
  PENDING
  VERIFIED
  DECLINED
}

enum Role {
  SUPER_ADMIN
  EDITOR
  JOURNALIST
  CONTRIBUTOR
  MODERATOR
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(CONTRIBUTOR)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  authorId String? @unique
  author   Author? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  // ---- Self-registration by local reporters (see /contribute) ------------
  contributorStatus ContributorStatus @default(VERIFIED)
  /** Where they report from. Shown to the admin reviewing the application. */
  location    String?
  /** Their own account of who they are and what they cover. */
  applicationNote String?
  /** Links to published work — the main thing an admin checks. */
  workLinks   String?
  appliedAt   DateTime?
  reviewedAt  DateTime?
  reviewedBy  String?
  /** Why an application was declined. Never shown to the applicant verbatim. */
  reviewNote  String?

  editorialLogs EditorialLog[]
}

// ---------------------------------------------------------------------------
// Articles
// ---------------------------------------------------------------------------

enum ArticleStatus {
  DRAFT
  REVIEW
  APPROVED
  PUBLISHED
  UPDATED
  ARCHIVED
}

// Homepage placement is set by an editor, never by an algorithm (spec §20).
enum Placement {
  NONE
  LEAD
  SECONDARY
  COUNTRY_LEAD
  SECTION_FEATURE
}

model Article {
  id       String @id @default(cuid())
  slug     String @unique
  headline String
  deck     String // short summary / standfirst
  body     String // paragraphs separated by a blank line

  countryId     String?
  regionId      String?
  categoryId    String
  subcategoryId String?
  authorId      String

  status      ArticleStatus @default(DRAFT)
  placement   Placement     @default(NONE)
  isBreaking  Boolean       @default(false)
  isDeveloping Boolean      @default(false)
  isSeed      Boolean       @default(false) // scaffolding, not reporting

  imageSeed    String
  imageUrl     String? // real photography once licensed; overrides the SVG
  imageCaption String
  imageCredit  String? // photographer or agency
  /** Licence name, e.g. "CC BY-SA 4.0". Displayed with the credit. */
  imageLicense String?
  /** Link to the original file page, so the licence can be checked. */
  imageSourceUrl String?
  sourceNote   String? // "Source:" line where a claim needs attribution

  seoTitle       String?
  seoDescription String?
  canonicalUrl   String?

  readMinutes Int      @default(3)
  publishedAt DateTime?
  revisedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  country     Country?     @relation("PrimaryCountry", fields: [countryId], references: [id], onDelete: SetNull)
  region      Region?      @relation(fields: [regionId], references: [id], onDelete: SetNull)
  category    Category     @relation(fields: [categoryId], references: [id])
  subcategory Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  author      Author       @relation(fields: [authorId], references: [id])

  countries    ArticleCountry[]
  topics       ArticleTopic[]
  views        ArticleViewDaily[]
  editorialLog EditorialLog[]
  homepageSlot HomepageSlot[]
  translations ArticleTranslation[]

  @@index([status, publishedAt])
  @@index([countryId, status, publishedAt])
  @@index([categoryId, status, publishedAt])
  @@index([placement, status])
}

// A story about Ethiopia–Somalia relations is first-class on both country
// pages and in /horn, without being duplicated. This join table is what makes
// the regional section structurally real rather than a tag.
model ArticleCountry {
  articleId String
  countryId String

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@id([articleId, countryId])
  @@index([countryId])
}

model ArticleTopic {
  articleId String
  topicId   String

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  topic   Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([articleId, topicId])
  @@index([topicId])
}

/**
 * Daily readership, one row per article per day.
 *
 * This replaced a table with one row per page view. That table reached 49,000
 * rows on synthetic seed data alone, and trending ran a groupBy across thirty
 * days of it on every homepage render — a query whose cost grows with traffic,
 * on the page that gets the most of it.
 *
 * A daily counter answers every question trending actually asks (how much was
 * this read, in this window) at roughly one row per article per day: a few
 * thousand rows a year rather than one per reader. Per-view granularity was
 * never used for anything.
 */
model ArticleViewDaily {
  articleId String
  /** Midnight UTC for the day being counted. */
  day       DateTime
  count     Int      @default(0)

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([articleId, day])
  @@index([day])
}

model EditorialLog {
  id         String        @id @default(cuid())
  articleId  String
  userId     String?
  fromStatus ArticleStatus?
  toStatus   ArticleStatus
  note       String?
  createdAt  DateTime      @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([articleId, createdAt])
}

// ---------------------------------------------------------------------------
// Video
// ---------------------------------------------------------------------------

enum VideoKind {
  NEWS
  INTERVIEW
  EXPLAINER
  DOCUMENTARY
  CULTURE
  BUSINESS
}

model Video {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  description String
  countryId   String?
  kind        VideoKind @default(NEWS)
  durationSec Int
  imageSeed   String
  provider    String? // "youtube" | "vimeo" | null while unpublished
  externalId  String?
  published   Boolean   @default(true)
  publishedAt DateTime  @default(now())

  country Country? @relation(fields: [countryId], references: [id], onDelete: SetNull)

  @@index([published, publishedAt])
}

// ---------------------------------------------------------------------------
// Homepage control, newsletter, advertising
// ---------------------------------------------------------------------------

// One row per editor-controlled homepage position.
model HomepageSlot {
  id        String  @id @default(cuid())
  slot      String  @unique // "lead", "secondary-1", "somalia-lead", ...
  articleId String?
  updatedAt DateTime @updatedAt

  article Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)
}

enum NewsletterEdition {
  DAILY
  WEEKLY
  SOMALIA
  ETHIOPIA
  DJIBOUTI
  ERITREA
}

model NewsletterSub {
  id          String            @id @default(cuid())
  email       String
  edition     NewsletterEdition @default(DAILY)
  countryPref String?
  confirmed   Boolean           @default(false)
  createdAt   DateTime          @default(now())

  @@unique([email, edition])
}

model AdSlot {
  id       String  @id @default(cuid())
  position String  @unique // header | homepage-mid | sidebar | in-article | footer
  label    String
  active   Boolean @default(false)
  html     String? // creative markup, sanitised on render
  linkUrl  String?

  @@index([active])
}

model SiteSetting {
  key   String @id
  value String
}

// ---------------------------------------------------------------------------
// News aggregation — "The Wire"
//
// Aggregated content is deliberately kept in its own models rather than mixed
// into Article. It is never our reporting, it is never edited into our voice,
// and it must never appear in Trending or a homepage lead slot. We store a
// headline, a short excerpt and a link; the full text stays on the publisher's
// own site, where their advertising and their byline are.
// ---------------------------------------------------------------------------

enum SourceKind {
  REGIONAL // an outlet based in or focused on one Horn country
  HORN // covers the Horn as a region
  PANAFRICAN // continental
  INTERNATIONAL // global wires and broadcasters
}

model Source {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  homepageUrl String
  feedUrl     String     @unique
  kind        SourceKind @default(REGIONAL)
  language    String     @default("en")
  countryId   String? // the country this outlet primarily covers
  active      Boolean    @default(true)
  order       Int        @default(0)
  note        String? // why it is inactive, permission status, etc.

  // State-owned or state-linked outlets are badged for readers rather than
  // excluded. Editors can change this in the CMS as ownership changes.
  stateAffiliated Boolean @default(false)

  // This outlet writes only about its own country, so an item of its that
  // names no country at all can safely be filed under `country`.
  //
  // Off by default and never inferred. It was measured first: outlets split
  // into papers covering their own market (Addis Fortune: "Power Utility
  // Spends Past Its Record Year") and outlets running a world-news section
  // (Jowhar, which files Musk, Assad and Nigel Farage). The two are
  // indistinguishable by any statistic tried — same share of untagged items —
  // so this is a judgement about a masthead, made by reading it, and it must
  // stay opt-in. Turning it on for an outlet that republishes world copy
  // re-creates the bug that filed a Colombian bombing under Somalia.
  localOnly Boolean @default(false)

  // Health, so a silently-dead feed is visible rather than just absent.
  lastFetchedAt DateTime?
  lastStatus    String? // "ok" | "http 403" | "timeout" | ...
  lastError     String?
  lastItemCount Int       @default(0)
  failureCount  Int       @default(0)

  // Publication date of the newest item this feed has ever offered us.
  //
  // Fetch health and editorial health are different things. Halbeeg answered
  // 200 with ten well-formed items on every run while its newest story was 591
  // days old — "ok" by every check we had, and contributing nothing. Without
  // this, an abandoned feed is indistinguishable from a quiet one.
  lastItemAt DateTime?

  country Country?   @relation(fields: [countryId], references: [id], onDelete: SetNull)
  items   WireItem[]

  @@index([active, order])
}

model WireItem {
  id       String @id @default(cuid())
  sourceId String

  // Publishers reuse guids inconsistently, so uniqueness is per source.
  guid    String
  url     String @unique
  title   String
  excerpt String // capped and stripped at ingest; never the full body
  author  String?
  imageUrl String?

  // When the feed we fetched is itself a syndicator, the newsroom that wrote
  // the piece. AllAfrica marks it in the body as "[Shabelle] ..." — crediting
  // the syndicator for someone else's reporting would be wrong, so it is
  // parsed out and shown as "Shabelle — via AllAfrica".
  originalPublisher String?

  publishedAt DateTime
  fetchedAt   DateTime @default(now())
  hidden      Boolean  @default(false) // moderator can suppress an item
  clicks      Int      @default(0)

  // Which desk this belongs on — inferred from the text, see topic-tagger.ts.
  // One desk per item, unlike countries, or every desk page becomes a copy of
  // the wire. Null is normal: an item with no clear desk stays on the wire and
  // its country page rather than being forced somewhere it does not belong.
  topic String?

  source    Source            @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  countries WireItemCountry[]

  @@unique([sourceId, guid])
  @@index([publishedAt])
  @@index([hidden, publishedAt])
  // Desk pages filter on topic and sort by date.
  @@index([topic, publishedAt])
}

// Same idea as ArticleCountry: one wire item can be relevant to several
// countries, so it surfaces on each of their pages without being duplicated.
model WireItemCountry {
  wireItemId String
  countryId  String

  wireItem WireItem @relation(fields: [wireItemId], references: [id], onDelete: Cascade)
  country  Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@id([wireItemId, countryId])
  @@index([countryId])
}

// ---------------------------------------------------------------------------
// Operations
// ---------------------------------------------------------------------------

/**
 * Fixed-window rate limiting, in the database.
 *
 * Serverless functions do not share memory, so an in-process counter limits
 * nothing once there are two instances. Postgres is the only state every
 * invocation already shares, and login attempts are far too low-volume for the
 * write cost to matter.
 */
model RateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())

  @@index([windowStart])
}

/**
 * Errors, kept where the operator can see them.
 *
 * A solo newsroom will not notice a 3am exception in a log stream. These rows
 * back /admin/errors so failures are visible without a third-party service; if
 * Sentry is added later this becomes redundant rather than in the way.
 */
model ErrorLog {
  id        String   @id @default(cuid())
  message   String
  stack     String?
  digest    String?
  path      String?
  kind      String   @default("server")
  count     Int      @default(1)
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([lastSeenAt])
  @@index([digest])
}

// ---------------------------------------------------------------------------
// Translation
// ---------------------------------------------------------------------------

enum Locale {
  EN
  SO
  AM
  AR
  TI
  FR
}

/**
 * A translated version of an article.
 *
 * Kept as rows rather than columns on Article because languages are additive:
 * adding Tigrinya must not be a migration, and an article translated into two
 * languages must not carry four empty columns.
 *
 * Translations carry their own review state. An article being published in
 * English says nothing about whether its Somali version has been read by
 * anyone who speaks Somali, and a half-finished translation of a security
 * story is worse than no translation at all — so a translation is only served
 * once it is PUBLISHED in its own right.
 */
enum TranslationStatus {
  DRAFT
  REVIEW
  PUBLISHED
}

model ArticleTranslation {
  id        String @id @default(cuid())
  articleId String
  locale    Locale

  headline String
  deck     String
  body     String

  status TranslationStatus @default(DRAFT)

  /** Who produced and who checked it — both recorded, neither invented. */
  translatedBy String?
  reviewedBy   String?

  /**
   * True when a machine produced the first draft. Editorial policy forbids
   * publishing unreviewed machine output, so this exists to make that
   * reviewable rather than to hide it.
   */
  machineAssisted Boolean @default(false)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, locale])
  @@index([locale, status])
}
