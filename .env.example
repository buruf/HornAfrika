# Copy to .env for local work. Never commit the real .env.

# Postgres in production (Neon, Supabase, Vercel Postgres — any of them).
# For offline local work set this to file:./dev.db AND change the provider in
# prisma/schema.prisma to "sqlite".
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Signs the CMS session cookie. Must be long and random.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# The public origin. Canonical URLs, OG images, the sitemap and the JSON-LD all
# derive from this, so a wrong value quietly poisons the site's SEO.
NEXT_PUBLIC_SITE_URL="https://hornafrika.com"

# Bearer token for GET /api/cron/aggregate. The endpoint fails closed without it.
CRON_SECRET=""

# Used only by `npm run db:seed` on a production database, to create the single
# Super Admin. The five demo accounts are never seeded outside development.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Administrator"
